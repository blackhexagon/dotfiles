{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-wakatime",
    {
      "package": "@kimaki/plugin-fallback",
      "options": {
        "models": [
          "anthropic/claude-opus-5-5",
          "openai/gpt-6-sol#high",
          "xai/grok-4.7"
        ]
      }
    }
  ],
  "mcp": {
    "servers": {
      "dokploy": {
        "type": "local",
        "command": ["npx", "-y", "@dokploy/mcp@latest"],
        "disabled": true,
        "environment": {
          "DOKPLOY_TOOL_PRESET": "deploy",
          "DOKPLOY_ENABLED_TAGS": "postgres,redis,mariadb",
          "DOKPLOY_URL": "https://dokploy.trca.dev",
          "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
        }
      },
      "resend": {
        "type": "remote",
        "url": "https://mcp.resend.com/mcp",
        "disabled": true
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "oauth": {},
        "disabled": true
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "oauth": {
          "client_id": "{env:FIGMA_CLIENT_ID}",
          "client_secret": "{env:FIGMA_CLIENT_SECRET}"
        },
        "disabled": true
      },
      "next-devtools": {
        "type": "local",
        "command": ["npx", "-y", "next-devtools-mcp@latest"],
        "disabled": true
      },
      "chome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "chrome-devtools-mcp@latest",
          "--executablePath=/usr/bin/chromium"
        ],
        "disabled": true
      },
      "neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp",
        "disabled": true
      }
    }
  },
  "formatter": {
    "php-cs-fixer": {
      "command": ["ddev", "exec", "vendor/bin/php-cs-fixer", "fix", "$FILE"],
      "extensions": [".php"]
    }
  }
}
