{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "u2b22.pomodoro",
          "calendar": "Work"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.indicators"
        }
      ],
      "right": [
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "u2b22.activity",
          "type": "command",
          "exec": "printf '󰍛\\n'",
          "interval": 3600,
          "tooltip": "Activity (btop)",
          "onClick": "omarchy launch or focus tui btop",
          "onRightClick": "omarchy launch terminal"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": []
}
